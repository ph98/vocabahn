generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  // Inferred CEFR level for the knowledge model; null until inferred
  cefrLevel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards           Card[]
  reviewLogs      ReviewLog[]
  knowledgeScores KnowledgeScore[]
  courses         UserCourse[]
  feedback        EntryFeedback[]
  decks           UserDeck[]
}

// ── Lexicon layer (complete Wiktextract ingest) ────────────────────────────

model LexiconEntry {
  id              String  @id @default(cuid())
  word            String
  pos             String
  // m / f / n, comma-joined when a word has several (e.g. "m,n")
  gender          String?
  ipa             String?
  hyphenation     String? // syllables joined with "·"
  etymology       String?
  etymologyNumber Int?
  frequencyRank   Int? // min rank over headword + all inflected forms (de_full.txt)
  // Full original Wiktextract record — escape hatch for fields not yet structured
  raw             Json
  createdAt       DateTime @default(now())

  senses          WordSense[]
  forms           WordForm[]
  dictionaryEntry DictionaryEntry?

  @@index([word])
  @@index([frequencyRank])
  @@index([pos])
}

model WordForm {
  id      String   @id @default(cuid())
  entryId String
  form    String
  // Grammatical tags, e.g. ["genitive","singular","strong"]
  tags    String[]
  source  String? // e.g. "declension", "conjugation"

  entry LexiconEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([form]) // inflected-form → lemma lookup
}

model WordSense {
  id       String   @id @default(cuid())
  entryId  String
  order    Int      @default(0)
  glosses  String[]
  tags     String[]
  topics   String[]
  synonyms String[]
  antonyms String[]

  entry LexiconEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

// ── Active learner-facing dictionary ────────────────────────────────────────

enum EnrichmentStatus {
  PENDING
  ENRICHING
  ENRICHED
  FAILED
}

enum ImageSource {
  UNSPLASH
  AI
  MANUAL
}

model DictionaryEntry {
  id               String           @id @default(cuid())
  lexiconEntryId   String           @unique
  word             String // denormalized headword for search
  translation      String?
  emoji            String?
  cefrLevel        String? // half sub-level, e.g. "A1.1" … "C2.2"
  // One concise learner-facing usage note (when/how to use + key grammar pitfall)
  usageNote        String?
  // AI learner aids: common collocations/idioms, English false
  // friends, register/domain, and a short memory hook.
  collocations     Json?
  falseFriends     Json?
  register         String?
  mnemonic         String?
  imageUrl         String?
  imageSource      ImageSource?
  audioUrl         String?
  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichmentError  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lexiconEntry LexiconEntry        @relation(fields: [lexiconEntryId], references: [id])
  examples     DictionaryExample[]
  imageCredit  ImageCredit?
  cards        Card[]
  courseWords  CourseWord[]
  deckWords    UserDeckWord[]
  feedback     EntryFeedback[]

  @@index([word])
  @@index([enrichmentStatus])
}

model DictionaryExample {
  id       String  @id @default(cuid())
  entryId  String
  order    Int     @default(0)
  de       String
  en       String
  audioUrl String? // TTS of the German sentence, cached as a static .mp3

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model ImageCredit {
  id         String  @id @default(cuid())
  entryId    String  @unique
  authorName String
  authorUrl  String?
  sourceUrl  String?

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

// ── Dictionary entry feedback (quality reports) ─────────────────────────────

enum FeedbackVote {
  UP
  DOWN
}

// Quick-pick issue categories shown as checkboxes alongside the free-text comment.
enum FeedbackIssue {
  LEVEL
  TRANSLATION
  IMAGE
  EMOJI
  AUDIO
  EXAMPLE
  GRAMMAR
  MNEMONIC
  OTHER
}

model EntryFeedback {
  id      String @id @default(cuid())
  entryId String
  userId  String
  // Denormalized headword, for quick filtering/browsing in AdminJS
  word    String

  vote    FeedbackVote?
  issues  FeedbackIssue[] @default([])
  comment String?

  // Context captured at submission time, to help triage quality reports
  userAgent String?
  locale    String?
  path      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([entryId])
  @@index([vote])
}

// ── Study loop: FSRS cards + review log ─────────────────────────────────────

enum KnownState {
  ACTIVE
  AUTO_KNOWN
  USER_KNOWN
  SUSPENDED
}

enum FsrsState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

model Card {
  id                String     @id @default(cuid())
  userId            String
  dictionaryEntryId String
  knownState        KnownState @default(ACTIVE)

  // FSRS state — recomputable by replaying ReviewLog (the log is the source of truth)
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Float     @default(0)
  scheduledDays Float     @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         FsrsState @default(NEW)
  lastReview    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dictionaryEntry DictionaryEntry @relation(fields: [dictionaryEntryId], references: [id])
  reviewLogs      ReviewLog[]

  @@unique([userId, dictionaryEntryId])
  @@index([userId, due])
  @@index([userId, knownState])
}

model ReviewLog {
  id     String       @id @default(cuid())
  cardId String
  userId String
  rating ReviewRating
  // Answer latency feeds the knowledge model's performance signal
  latencyMs Int?

  // FSRS snapshot at review time (ts-fsrs ReviewLog shape, enables replay)
  state         FsrsState
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Float
  scheduledDays Float
  reviewedAt    DateTime

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId, reviewedAt])
  @@index([userId, reviewedAt])
}

// ── Knowledge model (derived & recomputable) ────────────────────────────────

model KnowledgeScore {
  id                String   @id @default(cuid())
  userId            String
  dictionaryEntryId String
  score             Float
  // Component breakdown (performance / level / frequency priors) for transparency
  components        Json?
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dictionaryEntryId])
  @@index([userId, score])
}

// ── Courses ─────────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  cefrLevel   String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words       CourseWord[]
  enrollments UserCourse[]
}

model CourseWord {
  id                String @id @default(cuid())
  courseId          String
  dictionaryEntryId String
  order             Int

  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dictionaryEntry DictionaryEntry @relation(fields: [dictionaryEntryId], references: [id])

  @@unique([courseId, dictionaryEntryId])
  @@index([courseId, order])
}

model UserCourse {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ── User custom decks ────────────────────────────────────────────────────────

model UserDeck {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  words UserDeckWord[]

  @@index([userId])
  @@index([isPublic])
}

model UserDeckWord {
  id                String   @id @default(cuid())
  deckId            String
  dictionaryEntryId String
  addedAt           DateTime @default(now())

  deck            UserDeck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  dictionaryEntry DictionaryEntry @relation(fields: [dictionaryEntryId], references: [id])

  @@unique([deckId, dictionaryEntryId])
  @@index([deckId, addedAt])
}

// ── Email magic link OTPs ─────────────────────────────────────────────────────

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

// ── Misc ────────────────────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
