// Phase 0 schema: User only, to prove migrations work end-to-end.
// The full data model (Card, ReviewLog, Lexicon*, Dictionary*, Course*) lands
// with Phase 1 — see PRD §5 "Data model".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  // Inferred CEFR level for the knowledge model (PRD §4.5); null until inferred
  cefrLevel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
