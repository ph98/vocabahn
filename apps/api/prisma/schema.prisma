generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  timezone  String?
  // Inferred CEFR level for the knowledge model; null until inferred
  cefrLevel String?
  // Topic slugs from STORY_TOPICS the learner wants to read about. Empty means
  // no preference stated, which the story picker reads as "any topic".
  interests String[] @default([])
  // ── Daily study reminder (notifications.md) ──
  // Server-side by necessity: the sender is the server, so a localStorage flag
  // could not switch it off. Default false — nobody is opted in by upgrading.
  reminderEnabled Boolean @default(false)
  // Learner-local wall clock the reminder aims at. Interpreted in `timezone`,
  // falling back to UTC when that has never been sent.
  reminderHour    Int     @default(19)
  reminderMinute  Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards             Card[]
  reviewLogs        ReviewLog[]
  knowledgeScores   KnowledgeScore[]
  courses           UserCourse[]
  feedback          EntryFeedback[]
  decks             UserDeck[]
  stories           Story[]
  quizAttempts      QuizAttempt[]
  quizReports       QuizQuestionReport[]
  storyQuizAttempts StoryQuizAttempt[]
  pushSubscriptions PushSubscription[]

  @@index([reminderEnabled])
}

// ── Web Push ─────────────────────────────────────────────────────────────────

/// One browser on one device that has granted notification permission. A
/// learner can hold several; a `404`/`410` from the push service means this one
/// is dead and the row is deleted rather than retried.
model PushSubscription {
  id String @id @default(cuid())

  userId String
  /// The push service URL. Globally unique — it is the subscription's identity,
  /// and re-subscribing the same browser must update the row, not add a second.
  endpoint   String  @unique
  /// Client public key and auth secret from `PushSubscription.toJSON().keys`.
  p256dh     String
  auth       String
  /// Best-effort device label so two rows are tellable apart. Never trusted.
  userAgent  String?
  createdAt  DateTime  @default(now())
  /// Last time a push to this endpoint was accepted by the push service.
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Lexicon layer (complete Wiktextract ingest) ────────────────────────────

model LexiconEntry {
  id              String   @id @default(cuid())
  word            String
  pos             String
  // m / f / n, comma-joined when a word has several (e.g. "m,n")
  gender          String?
  ipa             String?
  hyphenation     String? // syllables joined with "·"
  etymology       String?
  etymologyNumber Int?
  frequencyRank   Int? // min rank over headword + all inflected forms (de_full.txt)
  // Full original Wiktextract record — escape hatch for fields not yet structured
  raw             Json
  createdAt       DateTime @default(now())

  senses          WordSense[]
  forms           WordForm[]
  dictionaryEntry DictionaryEntry?

  @@index([word])
  @@index([frequencyRank])
  @@index([pos])
}

model WordForm {
  id      String   @id @default(cuid())
  entryId String
  form    String
  // Grammatical tags, e.g. ["genitive","singular","strong"]
  tags    String[]
  source  String? // e.g. "declension", "conjugation"

  entry LexiconEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([form]) // inflected-form → lemma lookup
}

model WordSense {
  id       String   @id @default(cuid())
  entryId  String
  order    Int      @default(0)
  glosses  String[]
  tags     String[]
  topics   String[]
  synonyms String[]
  antonyms String[]

  entry LexiconEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

// ── Active learner-facing dictionary ────────────────────────────────────────

enum EnrichmentStatus {
  PENDING
  ENRICHING
  ENRICHED
  FAILED
}

enum ImageSource {
  UNSPLASH
  AI
  MANUAL
}

model DictionaryEntry {
  id               String           @id @default(cuid())
  lexiconEntryId   String           @unique
  word             String // denormalized headword for search
  translation      String?
  emoji            String?
  cefrLevel        String? // half sub-level, e.g. "A1.1" … "C2.2"
  // One concise learner-facing usage note (when/how to use + key grammar pitfall)
  usageNote        String?
  // AI learner aids: common collocations/idioms, English false
  // friends, register/domain, and a short memory hook.
  collocations     Json?
  falseFriends     Json?
  register         String?
  mnemonic         String?
  imageUrl         String?
  imageSource      ImageSource?
  audioUrl         String?
  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichmentError  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lexiconEntry  LexiconEntry        @relation(fields: [lexiconEntryId], references: [id])
  examples      DictionaryExample[]
  imageCredit   ImageCredit?
  cards         Card[]
  courseWords   CourseWord[]
  deckWords     UserDeckWord[]
  feedback      EntryFeedback[]
  storyTargets       StoryTarget[]
  storyQuizQuestions StoryQuizQuestion[]
  quizQuestions      EntryQuizQuestion[]
  quizAttempts       QuizAttempt[]

  @@index([word])
  @@index([enrichmentStatus])
  // Distractor sampling looks for entries at a neighbouring CEFR sub-level.
  @@index([cefrLevel])
}

model DictionaryExample {
  id       String  @id @default(cuid())
  entryId  String
  order    Int     @default(0)
  de       String
  en       String
  audioUrl String? // TTS of the German sentence, cached as a static .mp3

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model ImageCredit {
  id         String  @id @default(cuid())
  entryId    String  @unique
  authorName String
  authorUrl  String?
  sourceUrl  String?

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

// ── Dictionary entry feedback (quality reports) ─────────────────────────────

enum FeedbackVote {
  UP
  DOWN
}

// Quick-pick issue categories shown as checkboxes alongside the free-text comment.
enum FeedbackIssue {
  LEVEL
  TRANSLATION
  IMAGE
  EMOJI
  AUDIO
  EXAMPLE
  GRAMMAR
  MNEMONIC
  OTHER
}

model EntryFeedback {
  id      String @id @default(cuid())
  entryId String
  userId  String
  // Denormalized headword, for quick filtering/browsing in AdminJS
  word    String

  vote    FeedbackVote?
  issues  FeedbackIssue[] @default([])
  comment String?

  // Context captured at submission time, to help triage quality reports
  userAgent String?
  locale    String?
  path      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entry DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([entryId])
  @@index([vote])
}

// ── Per-word multiple-choice quiz ───────────────────────────────────────────

enum QuizQuestionType {
  MEANING
}

// Where an option came from, recorded parallel to `options` so a bad
// distractor can be traced back to the generator that produced it.
enum QuizOptionOrigin {
  ANSWER
  AI
  NEIGHBOUR
}

enum QuizReportReason {
  WRONG_ANSWER
  AMBIGUOUS
  TOO_EASY
  BAD_GERMAN
  OTHER
}

/// One 4-option question about a dictionary entry. Written by the enrichment
/// job from the same Gemini response that fills the entry itself — never by a
/// second AI call. Replaced wholesale on re-enrichment, which is why it is its
/// own table rather than a Json column: a single bad question is replaceable.
model EntryQuizQuestion {
  id            String             @id @default(cuid())
  entryId       String
  type          QuizQuestionType   @default(MEANING)
  order         Int                @default(0)
  prompt        String
  options       String[]
  correctIndex  Int
  // One short sentence shown after answering.
  explanation   String?
  // Generation metadata: the model that produced the question, and where each
  // option came from (index-aligned with `options`).
  generator     String?
  optionOrigins QuizOptionOrigin[] @default([])
  // Bumped by QuizQuestionReport; questions past REPORT_SUPPRESS_THRESHOLD stop
  // being served without anyone having to intervene.
  reportCount   Int                @default(0)
  createdAt     DateTime           @default(now())

  entry    DictionaryEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]
  reports  QuizQuestionReport[]

  @@index([entryId, order])
}

/// A learner's answer to one quiz question. Deliberately NOT a ReviewLog row:
/// ReviewLog is the FSRS source of truth and is replayed from empty state, so a
/// quiz result written there would corrupt scheduling. Nothing reads this table
/// yet — see docs/system/learning.md.
model QuizAttempt {
  id            String   @id @default(cuid())
  // Null once the question was replaced by a re-enrichment: the attempt
  // survives its question, so quiz history is not silently deleted.
  questionId    String?
  entryId       String
  userId        String
  selectedIndex Int
  correct       Boolean
  latencyMs     Int?
  createdAt     DateTime @default(now())

  question EntryQuizQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  entry    DictionaryEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entryId])
  @@index([questionId])
}

/// "This question is wrong" — the EntryFeedback pattern, scoped to one question
/// so the offending question can be identified rather than the whole entry.
model QuizQuestionReport {
  id         String @id @default(cuid())
  questionId String
  userId     String
  // Denormalized headword, for quick filtering/browsing in AdminJS
  word       String

  reason  QuizReportReason
  comment String?

  // Context captured at submission time, to help triage quality reports
  userAgent String?
  locale    String?
  path      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question EntryQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([questionId])
}

// ── Study loop: FSRS cards + review log ─────────────────────────────────────

enum KnownState {
  ACTIVE
  AUTO_KNOWN
  USER_KNOWN
  SUSPENDED
}

enum FsrsState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

model Card {
  id                String     @id @default(cuid())
  userId            String
  dictionaryEntryId String
  knownState        KnownState @default(ACTIVE)

  // FSRS state — recomputable by replaying ReviewLog (the log is the source of truth)
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Float     @default(0)
  scheduledDays Float     @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         FsrsState @default(NEW)
  lastReview    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dictionaryEntry DictionaryEntry @relation(fields: [dictionaryEntryId], references: [id])
  reviewLogs      ReviewLog[]

  @@unique([userId, dictionaryEntryId])
  @@index([userId, due])
  @@index([userId, knownState])
}

model ReviewLog {
  id        String       @id @default(cuid())
  cardId    String
  userId    String
  rating    ReviewRating
  // Answer latency feeds the knowledge model's performance signal
  latencyMs Int?

  // FSRS snapshot at review time (ts-fsrs ReviewLog shape, enables replay)
  state         FsrsState
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Float
  scheduledDays Float
  reviewedAt    DateTime

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId, reviewedAt])
  @@index([userId, reviewedAt])
}

// ── Knowledge model (derived & recomputable) ────────────────────────────────

model KnowledgeScore {
  id                String   @id @default(cuid())
  userId            String
  dictionaryEntryId String
  score             Float
  // Component breakdown (performance / level / frequency priors) for transparency
  components        Json?
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dictionaryEntryId])
  @@index([userId, score])
}

// ── Courses ─────────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  cefrLevel   String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  isComplete  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words       CourseWord[]
  enrollments UserCourse[]
}

model CourseWord {
  id                String @id @default(cuid())
  courseId          String
  dictionaryEntryId String
  order             Int

  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dictionaryEntry DictionaryEntry @relation(fields: [dictionaryEntryId], references: [id])

  @@unique([courseId, dictionaryEntryId])
  @@index([courseId, order])
}

model UserCourse {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ── User custom decks ────────────────────────────────────────────────────────

model UserDeck {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  words UserDeckWord[]

  @@index([userId])
  @@index([isPublic])
}

model UserDeckWord {
  id                String   @id @default(cuid())
  deckId            String
  dictionaryEntryId String
  addedAt           DateTime @default(now())

  deck            UserDeck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  dictionaryEntry DictionaryEntry @relation(fields: [dictionaryEntryId], references: [id])

  @@unique([deckId, dictionaryEntryId])
  @@index([deckId, addedAt])
}

// ── Micro-stories ────────────────────────────────────────────────────────────

enum StoryStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

// Sub-steps of GENERATING, so the client can narrate the wait rather than spin.
// Source selection is not among them: it happens synchronously when the row is
// created, so the learner never waits on it.
enum StoryStage {
  WRITING
  NARRATING
}

// Whether the learner asked for this story or the scheduler wrote it for them.
enum StoryOrigin {
  ON_DEMAND
  DAILY
}

model Story {
  id              String      @id @default(cuid())
  userId          String
  status          StoryStatus @default(PENDING)
  stage           StoryStage?
  origin          StoryOrigin @default(ON_DEMAND)
  // Topic slug from STORY_TOPICS (packages/shared). Null for stories generated
  // before topics existed, and for the "any topic" fallback when a learner has
  // no interests and no feed item could be found.
  topic           String?
  // The real article this was retold from, when there was one. The relation is
  // for analytics and per-user dedup; the three snapshot fields below are what
  // the UI renders, so attribution survives SourceItem pruning.
  sourceItemId    String?
  sourceTitle     String?
  sourceUrl       String?
  sourceName      String?
  sourcePublished DateTime?
  // Target sub-level at generation time, e.g. "A2.1" — a snapshot, not a live join
  cefrLevel       String?
  title           String?
  // German body. Every target's surfaceForm is verified to occur in this text.
  text            String?
  // Whole-story English translation, revealed on demand
  translation     String?
  // Narration of `text`, cached as a static .mp3 keyed `story-<id>`; null when
  // synthesis is unconfigured or failed — audio never blocks a story shipping
  audioUrl        String?
  // A scene-setting Unsplash photo, fetched during generation from an English
  // query the model returns alongside the text. Null is normal: stories written
  // before this existed, and any story whose fetch failed or found nothing.
  // Attribution is inline rather than through ImageCredit, which is hard-bound
  // to DictionaryEntry by a unique required relation. Unsplash's terms require
  // the photographer to be credited, so the name and links are stored, not just
  // the image URL.
  imageUrl        String?
  imageAuthorName String?
  imageAuthorUrl  String?
  // The photo's own Unsplash page, linked from the "on Unsplash" credit
  imageSourceUrl  String?
  error           String?
  // Set when the learner finishes reading; untapped targets become positive then
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceItem    SourceItem?         @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  targets       StoryTarget[]
  quizQuestions StoryQuizQuestion[]
  quizAttempts  StoryQuizAttempt[]

  @@index([userId, createdAt])
  // Drives "has this learner already read this article?"
  @@index([userId, sourceItemId])
}

// ── Source material ──────────────────────────────────────────────────────────

// One article headline + summary pulled from a German publisher's RSS feed.
// Only the feed's own title and description are stored — never the article body
// — and a story retells it in the learner's own level rather than reproducing
// it. `url` is the dedup key: re-polling a feed re-sees the same items.
model SourceItem {
  id          String   @id @default(cuid())
  // Topic slug from STORY_TOPICS. One item belongs to exactly one topic, even
  // when a publisher's feed could plausibly serve two.
  topic       String
  url         String   @unique
  title       String
  // The feed's <description>/<summary>, which is a 2–4 sentence German precis.
  summary     String
  // Publisher name for attribution, e.g. "tagesschau"
  sourceName  String
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  stories Story[]

  // The picker wants the newest unread item for a topic.
  @@index([topic, publishedAt])
}

// One row per (story, word). Doubles as the comprehension signal: `understood`
// records whether the learner tapped the word as "didn't land". Nothing consumes
// these yet — they exist so the signal can be designed from real data.
model StoryTarget {
  id                String    @id @default(cuid())
  storyId           String
  dictionaryEntryId String
  // Exact inflected form as it appears in Story.text, verified before insert
  surfaceForm       String
  // null until the story is completed; false = the learner tapped it
  understood        Boolean?
  respondedAt       DateTime?

  story           Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  dictionaryEntry DictionaryEntry @relation(fields: [dictionaryEntryId], references: [id])

  @@unique([storyId, dictionaryEntryId])
  @@index([dictionaryEntryId])
}

model StoryQuizQuestion {
  id                String   @id @default(cuid())
  storyId           String
  dictionaryEntryId String
  targetWord        String?
  order             Int      @default(0)
  prompt            String
  options           String[]
  correctIndex      Int
  explanation       String?
  createdAt         DateTime @default(now())

  story           Story              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  dictionaryEntry DictionaryEntry    @relation(fields: [dictionaryEntryId], references: [id])
  attempts        StoryQuizAttempt[]

  @@index([storyId, order])
  @@index([dictionaryEntryId])
}

model StoryQuizAttempt {
  id            String   @id @default(cuid())
  questionId    String
  storyId       String
  userId        String
  selectedIndex Int
  correct       Boolean
  latencyMs     Int?
  createdAt     DateTime @default(now())

  question StoryQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  story    Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, storyId])
  @@index([questionId])
}

// ── Email magic link OTPs ─────────────────────────────────────────────────────

model EmailOtp {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ── Misc ────────────────────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
