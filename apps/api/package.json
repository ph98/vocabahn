{
  "name": "@vocabahn/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:generate": "prisma generate",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "ingest:lexicon": "dotenv -e ../../.env -- tsx scripts/ingest-lexicon.ts",
    "seed:dictionary": "dotenv -e ../../.env -- tsx scripts/seed-dictionary.ts",
    "stats": "dotenv -e ../../.env -- tsx scripts/stats.ts",
    "admin": "dotenv -e ../../.env -- tsx scripts/admin.mts"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/prisma": "^5.0.4",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.8.0",
    "@vocabahn/shared": "workspace:*",
    "adminjs": "^7.8.17",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fuse.js": "^7.1.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.8.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
