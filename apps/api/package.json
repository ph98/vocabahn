  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:generate": "prisma generate",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "ingest:lexicon": "dotenv -e ../../.env -- tsx scripts/ingest-lexicon.ts",
    "seed:dictionary": "dotenv -e ../../.env -- tsx scripts/seed-dictionary.ts",
    "seed:course": "dotenv -e ../../.env -- tsx scripts/seed-course.ts",
    "seed:cefr-courses": "dotenv -e ../../.env -- tsx scripts/seed-cefr-courses.ts",
    "sync:course-levels": "dotenv -e ../../.env -- tsx scripts/sync-course-levels.ts",
    "repair:cefr-levels": "dotenv -e ../../.env -- tsx scripts/repair-cefr-levels.ts",
    "generate:c1-c2": "dotenv -e ../../.env -- tsx scripts/generate-c1-c2.ts",
    "seed:decks": "dotenv -e ../../.env -- tsx scripts/seed-decks.ts",
    "stats": "dotenv -e ../../.env -- tsx scripts/stats.ts"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google/genai": "^2.13.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.8.0",
    "@sentry/node": "^10.68.0",
    "@vocabahn/shared": "workspace:*",
    "bullmq": "^5.81.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "fuse.js": "^7.5.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-fsrs": "^5.4.1",
    "tslib": "^2.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.29",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.8.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
