# Database
DATABASE_URL="postgresql://vocabahn:vocabahn@localhost:5432/vocabahn"

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Server Settings
PORT=3000
NODE_ENV=development

# Frontend Integration
FRONTEND_URL=http://localhost:5173
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=

# Authentication (JWT & OAuth)
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=
# Google OAuth 2.0 — console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/redirect

# Email magic-link sign-in (optional — if unset, links are logged to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vocabahn <noreply@vocabahn.com>"

# Self-Hosted Admin Panel (Directus) — see docs/operations.md
# openssl rand -base64 32
DIRECTUS_KEY=
# openssl rand -base64 32
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=admin@vocabahn.com
DIRECTUS_ADMIN_PASSWORD=

# Google Gemini (AI word enrichment) — aistudio.google.com/apikey
GEMINI_API_KEY=

# Max on-demand word enrichments per user per day (PRD §6 abuse control); default 50
ENRICHMENT_DAILY_CAP=50

# Google Cloud Text-to-Speech
# Path to your service account key JSON file (or place service-account.json in repo root)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT=

# ElevenLabs Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Unsplash API for image generation — unsplash.com/developers
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APP_ID=

# Web Push (daily study reminder). Unset means reminders are off and the
# settings UI says so; the app boots and behaves normally either way.
# Generate once with: npx web-push generate-vapid-keys
# Changing the pair invalidates every stored PushSubscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push service can reach you at (mailto: or https:)
VAPID_SUBJECT=mailto:support@vocabahn.app

# reCAPTCHA — google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# Telemetry & Monitoring (Analytics & Error Tracking)
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
SENTRY_DSN=

# Product feedback widget (Usersnap) — usersnap.com > Settings > Install
# The Space ("global") API key. Leave empty to switch the feedback button off
# entirely: no script is fetched and no trigger renders. Loaded only after the
# visitor grants analytics consent. See docs/system/analytics.md.
VITE_USERSNAP_API_KEY=

# Docker Compose (production)
POSTGRES_PASSWORD=
