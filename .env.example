# Database
DATABASE_URL="postgresql://vocabahn:vocabahn@localhost:5432/vocabahn"

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Server Settings
PORT=3000
NODE_ENV=development

# Frontend Integration
FRONTEND_URL=http://localhost:5173
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=

# Authentication (JWT & OAuth)
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=
# Google OAuth 2.0 — console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/redirect

# Email magic-link sign-in (optional — if unset, links are logged to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vocabahn <noreply@vocabahn.com>"

# Admin Panel (AdminJS) — dev monitoring UI, see docs/development.md
ADMIN_EMAIL=admin@vocabahn.com
ADMIN_PASSWORD=
# openssl rand -hex 24
ADMIN_COOKIE_PASSWORD=
ADMIN_PORT=3001

# Google Gemini (AI word enrichment) — aistudio.google.com/apikey
GEMINI_API_KEY=

# Max on-demand word enrichments per user per day (PRD §6 abuse control); default 50
ENRICHMENT_DAILY_CAP=50

# Google Cloud Text-to-Speech
# Path to your service account key JSON file (or place service-account.json in repo root)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT=

# ElevenLabs Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Unsplash API for image generation — unsplash.com/developers
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APP_ID=

# reCAPTCHA — google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# Docker Compose (production)
POSTGRES_PASSWORD=
