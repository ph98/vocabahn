{
  "name": "vocabahn",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @vocabahn/shared build && pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:migrate": "pnpm --filter @vocabahn/api prisma:migrate",
    "prisma:generate": "pnpm --filter @vocabahn/api prisma:generate",
    "studio": "pnpm --filter @vocabahn/api studio",
    "admin": "pnpm --filter @vocabahn/api admin",
    "stats": "pnpm --filter @vocabahn/api stats",
    "health": "curl http://localhost:3000/api/v1/health",
    "release": "bash scripts/release.sh",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "tinymce": "^7.9.3",
    "react-router": "^8.3.0",
    "brace-expansion": "^5.0.8"
  }
}
